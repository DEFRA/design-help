{% extends 'layouts/page.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Design help</h1>

      <p class="govuk-body-l">
        A place for the Defra DDTS design team to keep GDaD evidence, see scores and talk them through with your manager.
      </p>

      <p class="govuk-body">You can use it to:</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>add evidence for the 7 GDaD design skills</li>
        <li>see your scores and capability level</li>
        <li>see your team’s evidence and scores, if you are a line manager</li>
        <li>find someone in the team who can help you</li>
      </ul>

      {% if signInAvailable %}
        <p class="govuk-body">
          <a class="govuk-link govuk-link--no-visited-state" href="/sign-in">Sign in</a>
          with your Defra email address to get started.
        </p>
      {% else %}
        <p class="govuk-body">
          Design help is being set up — signing in will be available soon.
        </p>
      {% endif %}
    </div>
  </div>
{% endblock %}
