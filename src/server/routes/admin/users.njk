{% extends 'layouts/page.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% set adminToolsActiveTab = 'people' %}
      {% include "partials/admin-tools-nav.njk" %}

      <h1 class="govuk-heading-xl">People and access</h1>

      {% if savedBanner %}
        {{ govukNotificationBanner({ type: "success", text: savedBanner }) }}
      {% endif %}

      {% if inviteResult %}
        {% if inviteResult.isSuccess %}
          {{ govukNotificationBanner({ type: "success", text: inviteResult.text }) }}
        {% else %}
          {{ govukNotificationBanner({ titleText: "Some invites were not sent", text: inviteResult.text }) }}
        {% endif %}
      {% endif %}

      {% if adminMsg %}
        {% if adminMsg.isSuccess %}
          {{ govukNotificationBanner({ type: "success", text: adminMsg.text }) }}
        {% else %}
          {{ govukErrorSummary({
            titleText: "There is a problem",
            errorList: [{ text: adminMsg.text }]
          }) }}
        {% endif %}
      {% endif %}

      <p class="govuk-body">Add people, set their job title and line manager, and give or remove admin access. People marked Pending haven’t signed in yet.</p>

      <p class="govuk-body govuk-!-margin-bottom-6">
        <a class="govuk-button" data-module="govuk-button" href="/admin/people/new">Add a person</a>
      </p>

      {% if pendingInviteCount > 0 %}
        <p class="govuk-body">
          <a class="govuk-button govuk-button--secondary" data-module="govuk-button" href="/admin/users/invite-pending">Invite everyone who’s pending ({{ pendingInviteCount }})</a>
        </p>
      {% endif %}

      {% if rows and rows.length > 0 %}
        <table class="govuk-table govuk-!-margin-bottom-8">
          <caption class="govuk-table__caption govuk-visually-hidden">People, their access and profiles</caption>
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">Name</th>
              <th scope="col" class="govuk-table__header">Job title</th>
              <th scope="col" class="govuk-table__header design-help-admin-users__account-header">Account</th>
              <th scope="col" class="govuk-table__header design-help-admin-users__actions-header">Actions</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for row in rows %}
              <tr class="govuk-table__row{% if row.pendingActivation %} app-admin-row--pending{% endif %}">
                <td class="govuk-table__cell design-help-admin-users__person">
                  {% if row.name %}
                    <span class="design-help-admin-users__name">{{ row.name }}</span>
                    {% if row.email %}
                      <span class="govuk-body-s design-help-admin-users__email">{{ row.email }}</span>
                    {% endif %}
                  {% elif row.email %}
                    <span class="design-help-admin-users__name">{{ row.email }}</span>
                  {% else %}
                    <span class="govuk-body app-admin-muted">—</span>
                  {% endif %}
                </td>
                <td class="govuk-table__cell">{{ row.role if row.role else "—" }}</td>
                <td class="govuk-table__cell design-help-admin-users__account">
                  {# Only statuses that need attention get a tag (GOV.UK task list pattern) #}
                  {% if row.pendingActivation %}
                    <strong class="govuk-tag govuk-tag--yellow">Pending</strong>
                    {% if row.canInvite %}
                      <div class="design-help-admin-users__invite">
                        <form method="post" action="/admin/users/{{ row.id }}/invite">
                          <input type="hidden" name="crumb" value="{{ crumb }}">
                          <button type="submit" class="govuk-button" data-module="govuk-button" data-prevent-double-click="true">Send invite<span class="govuk-visually-hidden"> to {{ row.name or row.email }}</span></button>
                        </form>
                      </div>
                    {% elif row.accessRemoved %}
                      <p class="govuk-hint design-help-admin-users__invite">Access removed — can’t invite</p>
                    {% endif %}
                  {% elif row.isBootstrapAdmin %}
                    Service admin
                  {% elif row.isAdmin %}
                    Admin
                  {% elif row.hasProfile %}
                    Active
                  {% else %}
                    —
                  {% endif %}
                </td>
                <td class="govuk-table__cell">
                  <div class="design-help-admin-users-actions">
                    {% if user.isHeadOfDesignSuperUser %}
                      <a class="govuk-button govuk-button--secondary" data-module="govuk-button" href="/admin/team-member/{{ row.id }}">Change<span class="govuk-visually-hidden"> team set-up for {{ row.name or row.email }}</span></a>
                    {% endif %}
                    {% if row.hasProfile and not user.isHeadOfDesignSuperUser %}
                      <a class="govuk-button govuk-button--secondary" data-module="govuk-button" href="/admin/users/{{ row.id }}/edit">Edit profile<span class="govuk-visually-hidden"> for {{ row.name or row.email }}</span></a>
                    {% endif %}
                    {% if row.hasProfile %}
                      <a class="govuk-button govuk-button--warning" data-module="govuk-button" href="/admin/profile/{{ row.id }}/confirm-delete">Delete<span class="govuk-visually-hidden"> for {{ row.name or row.email }}</span></a>
                    {% else %}
                      <a class="govuk-button govuk-button--warning" data-module="govuk-button" href="/admin/approved-emails/{{ row.id }}/confirm-delete">Remove from list<span class="govuk-visually-hidden"> for {{ row.name or row.email }}</span></a>
                    {% endif %}
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <p class="govuk-body">No approved people configured yet.</p>
      {% endif %}
    </div>
  </div>
{% endblock %}
