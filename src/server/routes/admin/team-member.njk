{% extends 'layouts/page.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukBackLink({ text: "Back to People and access", href: "/admin/users" }) }}

      {% if errorList.length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorList
        }) }}
      {% endif %}

      <h1 class="govuk-heading-xl">{{ heading }}</h1>

      <p class="govuk-body">
        {% if isEdit %}
          Change who this person is and who manages them.
        {% else %}
          Add someone to the team before they sign in. They’ll fill in the rest of their profile, such as location and availability, when they first sign in.
        {% endif %}
      </p>

      {% if duplicateChangeHref %}
        <p class="govuk-body">
          <a class="govuk-link" href="{{ duplicateChangeHref }}">Change the details of the person who already has this email address</a>
        </p>
      {% endif %}

      {% if possibleDuplicates.length %}
        <div class="govuk-inset-text" id="possible-duplicates">
          <h2 class="govuk-heading-m">Check they are not already on the list</h2>
          {{ govukWarningText({
            text: "We found " + ("someone" if possibleDuplicates.length == 1 else "people") + " with a similar name or email address. Adding the same person twice means they appear twice, for example in the line manager list.",
            iconFallbackText: "Warning"
          }) }}
          <ul class="govuk-list govuk-list--bullet">
            {% for match in possibleDuplicates %}
              <li>
                {% if match.name %}
                  <a class="govuk-link" href="{{ match.href }}">{{ match.name }}</a> ({{ match.email }})
                {% else %}
                  <a class="govuk-link" href="{{ match.href }}">{{ match.email }}</a> (no name yet)
                {% endif %}
              </li>
            {% endfor %}
          </ul>
          <p class="govuk-body">If this is the same person, select them above to change their details instead. If not, check the details below and add them.</p>
        </div>
      {% endif %}

      <form method="post" action="{{ formAction }}" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {{ govukInput({
          label: { text: "Full name", classes: "govuk-label--m" },
          id: "name",
          name: "name",
          value: form.name,
          autocomplete: "off",
          spellcheck: false,
          errorMessage: { text: errors.name } if errors.name
        }) }}

        {{ govukInput({
          label: { text: "Defra email address", classes: "govuk-label--m" },
          hint: { text: "They’ll use this to sign in, for example name@defra.gov.uk" },
          id: "email",
          name: "email",
          type: "email",
          value: form.email,
          autocomplete: "off",
          spellcheck: false,
          errorMessage: { text: errors.email } if errors.email
        }) }}

        {{ govukSelect({
          label: { text: "Job title", classes: "govuk-label--m" },
          id: "role",
          name: "role",
          items: roleItems,
          errorMessage: { text: errors.role } if errors.role
        }) }}

        {{ govukSelect({
          label: { text: "Line manager", classes: "govuk-label--m" },
          hint: { text: "Only people marked as managing other designers are listed" },
          id: "managerId",
          name: "managerId",
          items: managerItems,
          errorMessage: { text: errors.managerId } if errors.managerId
        }) }}

        {% if isEdit and wasLineManager and reportCount > 0 %}
          {{ govukWarningText({
            text: "This person manages " + reportCount + (" person" if reportCount == 1 else " people") + ". If you untick the box below, " + ("that person" if reportCount == 1 else "those people") + " will have no line manager.",
            iconFallbackText: "Warning"
          }) }}
        {% elif isEdit and wasLineManager %}
          <p class="govuk-body">If you untick the box below, they will no longer appear in the line manager list.</p>
        {% endif %}

        {{ govukCheckboxes({
          name: "isLineManager",
          classes: "govuk-checkboxes--small",
          fieldset: {
            legend: { text: "Line management", classes: "govuk-fieldset__legend--m" }
          },
          items: [
            {
              value: "yes",
              text: "This person manages other designers",
              checked: form.isLineManager
            }
          ]
        }) }}

        {% if adminAccess %}
          {% if adminAccess.canChange %}
            {{ govukRadios({
              name: "isAdmin",
              classes: "govuk-radios--inline",
              fieldset: {
                legend: { text: "Admin access", classes: "govuk-fieldset__legend--m" }
              },
              hint: { text: "Admins can manage people and access" },
              items: [
                { value: "yes", text: "Yes", checked: form.isAdmin },
                { value: "no", text: "No", checked: not form.isAdmin }
              ]
            }) }}
          {% else %}
            <h2 class="govuk-heading-m">Admin access</h2>
            <p class="govuk-body" id="admin-access-readonly">
              {% if adminAccess.reason == "protected" %}
                Admin access: Yes (protected — set in configuration)
              {% elif adminAccess.reason == "self" %}
                Admin access: {{ "Yes" if adminAccess.isAdmin else "No" }} (you cannot remove your own admin access)
              {% else %}
                Admin access: {{ "Yes" if adminAccess.isAdmin else "No" }}
              {% endif %}
            </p>
          {% endif %}
        {% endif %}

        <div class="govuk-button-group">
          {% if possibleDuplicates.length %}
            {{ govukButton({
              text: "Yes, this is a different person – add them",
              name: "confirmNotDuplicate",
              value: "yes"
            }) }}
          {% else %}
            {{ govukButton({ text: "Save changes" if isEdit else "Set up team member" }) }}
          {% endif %}
          <a class="govuk-link" href="/admin/users">Cancel</a>
        </div>
      </form>

      {% if profileHref %}
        <p class="govuk-body">
          <a class="govuk-link" href="{{ profileHref }}">Edit their Find help profile</a>
        </p>
      {% endif %}
    </div>
  </div>
{% endblock %}
