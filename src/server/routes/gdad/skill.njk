{% extends 'layouts/page.njk' %}
{% from "partials/gdad.njk" import gdadSkillDetail, gdadEvidenceSections %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <a class="govuk-back-link" href="/my-gdad-evidence">Back to My GDaD evidence</a>

      {% if evidenceBanner and evidenceBanner.success %}
        {{ govukNotificationBanner({
          type: "success",
          text: evidenceBanner.text
        }) }}
      {% elif evidenceBanner %}
        {{ govukNotificationBanner({ text: evidenceBanner.text }) }}
      {% endif %}

      <span class="govuk-caption-l">{{ user.name }} · GDaD evidence</span>
      <h1 class="govuk-heading-xl">{{ skill.label }}</h1>

      {{ gdadSkillDetail({
        skill: skill,
        frameworkRoleLabel: frameworkRoleLabel,
        frameworkRolePageUrl: frameworkRolePageUrl
      }) }}

      {{ gdadEvidenceSections({
        skill: skill,
        skillUrl: skillUrl,
        canEdit: true,
        isOwn: true
      }) }}

    </div>
  </div>
{% endblock %}
