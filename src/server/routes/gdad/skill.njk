{% extends 'layouts/page.njk' %}
{% from "partials/gdad.njk" import gdadSkillDetail %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <a class="govuk-back-link" href="/my-gdad-evidence">Back to My GDaD evidence</a>

      {% if justSaved %}
        {{ govukNotificationBanner({
          type: "success",
          text: "Evidence saved"
        }) }}
      {% elif nothingChanged %}
        {{ govukNotificationBanner({ text: "Your evidence was not changed." }) }}
      {% endif %}

      <span class="govuk-caption-l">{{ user.name }} · GDaD evidence</span>
      <h1 class="govuk-heading-xl">{{ skill.label }}</h1>

      {{ gdadSkillDetail({
        skill: skill,
        frameworkRoleLabel: frameworkRoleLabel,
        frameworkRolePageUrl: frameworkRolePageUrl
      }) }}

      <h2 class="govuk-heading-m">Evidence (STAR)</h2>

      {% if skill.evidenceText %}
        {{ skill.evidenceText | markdownToGovukHtml }}
        {% if skill.evidenceUpdatedLabel %}
          <p class="govuk-body-s govuk-hint">Last updated {{ skill.evidenceUpdatedLabel }}</p>
        {% endif %}
        {{ govukButton({
          text: "Edit evidence",
          href: "/my-gdad-evidence/" + skill.key + "/edit",
          classes: "govuk-button--secondary"
        }) }}
      {% else %}
        <p class="govuk-body">You haven’t added evidence for this skill yet.</p>
        {{ govukButton({
          text: "Add evidence",
          href: "/my-gdad-evidence/" + skill.key + "/edit"
        }) }}
      {% endif %}

    </div>
  </div>
{% endblock %}
