{% extends 'layouts/page.njk' %}
{% from "partials/gdad.njk" import gdadSkillDetail %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <a class="govuk-back-link" href="/my-gdad-evidence">Back to My GDaD evidence</a>

      {% if justSaved %}
        {{ govukNotificationBanner({
          type: "success",
          text: "Evidence saved"
        }) }}
      {% endif %}

      {% if error %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [{ text: error, href: "#evidence-" + skill.key }]
        }) }}
      {% endif %}

      <span class="govuk-caption-l">{{ user.name }} · GDaD evidence</span>
      <h1 class="govuk-heading-xl">{{ skill.label }}</h1>

      {{ gdadSkillDetail({
        skill: skill,
        frameworkRoleLabel: frameworkRoleLabel,
        frameworkRolePageUrl: frameworkRolePageUrl
      }) }}

      <h2 class="govuk-heading-m">Evidence (STAR)</h2>

      <form method="post" action="/my-gdad-evidence/{{ skill.key }}" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {{ govukCharacterCount({
          id: "evidence-" + skill.key,
          name: "evidence_" + skill.key,
          maxlength: 12000,
          rows: 12,
          value: evidenceValue if evidenceValue is defined else skill.evidenceText,
          label: {
            text: "Your evidence",
            classes: "govuk-label--s"
          },
          hint: {
            text: skill.starHint
          },
          errorMessage: { text: error } if error
        }) }}

        {{ govukButton({ text: "Save evidence" }) }}
      </form>

    </div>
  </div>
{% endblock %}
