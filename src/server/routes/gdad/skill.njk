{% extends 'layouts/page.njk' %}
{% from "partials/gdad.njk" import gdadSkillDetail %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <a class="govuk-back-link" href="/my-gdad-evidence">Back to My GDaD evidence</a>

      {% if justSaved %}
        {{ govukNotificationBanner({
          type: "success",
          text: "Evidence saved"
        }) }}
      {% endif %}

      {% if error %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [{ text: error, href: "#evidence-" + skill.key }]
        }) }}
      {% endif %}

      <span class="govuk-caption-l">{{ user.name }} · GDaD evidence</span>
      <h1 class="govuk-heading-xl">{{ skill.label }}</h1>

      {{ gdadSkillDetail({
        skill: skill,
        frameworkRoleLabel: frameworkRoleLabel,
        frameworkRolePageUrl: frameworkRolePageUrl,
        gdadSkillsMatrixUrl: gdadSkillsMatrixUrl
      }) }}

      <h2 class="govuk-heading-m">Evidence (STAR)</h2>

      <form method="post" action="/my-gdad-evidence/{{ skill.key }}" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">

        <div class="govuk-form-group govuk-character-count" data-module="govuk-character-count" data-maxlength="12000">
          <label class="govuk-label govuk-label--s" for="evidence-{{ skill.key }}">Your evidence</label>
          <div id="evidence-{{ skill.key }}-hint" class="govuk-hint">{{ skill.starHint }}</div>
          <textarea class="govuk-textarea govuk-js-character-count" id="evidence-{{ skill.key }}" name="evidence_{{ skill.key }}" rows="12" aria-describedby="evidence-{{ skill.key }}-hint evidence-{{ skill.key }}-info">{{ skill.evidenceText }}</textarea>
          <div id="evidence-{{ skill.key }}-info" class="govuk-hint govuk-character-count__message">You can enter up to 12,000 characters</div>
        </div>

        {{ govukButton({ text: "Save evidence" }) }}
      </form>

    </div>
  </div>
{% endblock %}
