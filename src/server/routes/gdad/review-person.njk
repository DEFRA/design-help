{% extends 'layouts/page.njk' %}
{% from "partials/gdad.njk" import gdadFrameworkLinks, gdadScoringExplainer, gdadCapabilityPanel, gdadSkillsTable %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      <a class="govuk-back-link" href="/my-team">Back to My team</a>

      {% if error and canEditScores %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [{ text: error, href: "#score-" + errorSkillKey }]
        }) }}
      {% endif %}

      <span class="govuk-caption-l">{{ targetName }} · {{ targetRole }}</span>
      <h1 class="govuk-heading-xl">GDaD evidence</h1>

      {% if justSaved and canEditScores %}
        {% if scoresEmail and scoresEmail.state == "ready" %}
          {% set savedHtml %}
            <p class="govuk-notification-banner__heading">Scores saved.</p>
            <p class="govuk-body"><a class="govuk-notification-banner__link" href="#scores-email">Email {{ targetName }} to tell them their scores have been updated</a></p>
          {% endset %}
          {{ govukNotificationBanner({ type: "success", html: savedHtml }) }}
        {% else %}
          {{ govukNotificationBanner({
            type: "success",
            text: "Scores saved."
          }) }}
        {% endif %}
      {% endif %}

      {% if scoresEmailResult and canEditScores %}
        {% if scoresEmailResult.kind == "success" %}
          {{ govukNotificationBanner({ type: "success", text: scoresEmailResult.text }) }}
        {% elif scoresEmailResult.kind == "partial" %}
          {{ govukNotificationBanner({ titleText: "Line manager not copied in", text: scoresEmailResult.text }) }}
        {% else %}
          {{ govukNotificationBanner({ titleText: "Email not sent", text: scoresEmailResult.text }) }}
        {% endif %}
      {% endif %}

      {{ gdadFrameworkLinks({
        frameworkRoleLabel: frameworkRoleLabel,
        frameworkRolePageUrl: frameworkRolePageUrl,
        gdadSkillsMatrixUrl: gdadSkillsMatrixUrl
      }) }}
      {{ gdadScoringExplainer() }}

      {{ gdadCapabilityPanel(capabilityBand) }}

      {% if canEditScores %}
        <form method="post" action="/review/gdad-evidence/{{ targetPersonId }}" novalidate>
          <input type="hidden" name="crumb" value="{{ crumb }}">
          {{ gdadSkillsTable({
            skillRows: skillRows,
            skillHref: "/review/gdad-evidence/" + targetPersonId + "/",
            scoreControls: true,
            errorSkillKey: errorSkillKey,
            errorText: error
          }) }}

          {{ govukButton({ text: "Save scores" }) }}
        </form>

        <p class="govuk-body">
          Open a skill to read the full evidence and score it.
        </p>

        {% if scoresEmail %}
          <div id="scores-email" class="gdad-scores-email">
            <h2 class="govuk-heading-m">Tell {{ targetName }} about their scores</h2>
            {% if scoresEmail.state == "ready" %}
              {% if scoresEmail.lastSentLabel %}
                <p class="govuk-body">Last emailed on {{ scoresEmail.lastSentLabel }}.</p>
              {% endif %}
              <p class="govuk-body">The email links to their GDaD evidence in Design Help. It does not include their scores.</p>
              <form method="post" action="/review/gdad-evidence/{{ targetPersonId }}/notify-scores" novalidate>
                <input type="hidden" name="crumb" value="{{ crumb }}">
                {% if scoresEmail.managerName %}
                  <div id="scores-email-hint" class="govuk-hint">Their line manager, {{ scoresEmail.managerName }}, will be copied in.</div>
                {% endif %}
                {{ govukButton({
                  text: "Email " + targetName + " to tell them their scores have been updated",
                  classes: "govuk-button--secondary",
                  preventDoubleClick: true,
                  attributes: { "aria-describedby": "scores-email-hint" } if scoresEmail.managerName else {}
                }) }}
              </form>
            {% else %}
              <p class="govuk-body">{{ targetName }} was emailed about their scores on {{ scoresEmail.lastSentLabel }}.</p>
            {% endif %}
          </div>
        {% endif %}
      {% else %}
        {{ govukInsetText({
          text: "Scores are given by the Head of Design. You can see them here to plan next steps with " + targetName + "."
        }) }}

        {{ gdadSkillsTable({
          skillRows: skillRows,
          skillHref: "/review/gdad-evidence/" + targetPersonId + "/"
        }) }}

        <p class="govuk-body">
          Open a skill to read the full evidence.
        </p>
      {% endif %}
    </div>
  </div>
{% endblock %}
