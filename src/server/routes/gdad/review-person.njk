{% extends 'layouts/page.njk' %}
{% from "partials/gdad.njk" import gdadFrameworkLinks, gdadCapabilityPanel, gdadSkillsTable, gdadScoresEmailForm %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      <a class="govuk-back-link" href="/my-team">Back to My team</a>

      {% if error and canEditScores %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [{ text: error, href: "#score-" + errorSkillKey }]
        }) }}
      {% endif %}

      {# Banners sit at the very top, so they are seen without scrolling #}
      {% if scoresEmailResult and canEditScores %}
        {% if scoresEmailResult.kind == "success" %}
          {{ govukNotificationBanner({ type: "success", text: scoresEmailResult.text }) }}
        {% elif scoresEmailResult.kind == "partial" %}
          {{ govukNotificationBanner({ titleText: "Line manager not copied in", text: scoresEmailResult.text }) }}
        {% else %}
          {{ govukNotificationBanner({ titleText: "Email not sent", text: scoresEmailResult.text }) }}
        {% endif %}
      {% endif %}

      {% if justSaved and canEditScores %}
        {{ govukNotificationBanner({ type: "success", text: "Scores saved." }) }}
      {% endif %}

      {% if nothingChanged and canEditScores %}
        {{ govukNotificationBanner({ text: "No scores were changed." }) }}
      {% endif %}

      <span class="govuk-caption-l">{{ targetName }} · {{ targetRole }}</span>
      <h1 class="govuk-heading-xl">GDaD evidence</h1>

      {{ gdadFrameworkLinks({
        frameworkRoleLabel: frameworkRoleLabel,
        frameworkRolePageUrl: frameworkRolePageUrl
      }) }}

      {{ gdadCapabilityPanel(capabilityBand) }}

      {% if canEditScores %}
        <form method="post" action="/review/gdad-evidence/{{ targetPersonId }}" novalidate>
          <input type="hidden" name="crumb" value="{{ crumb }}">
          {{ gdadSkillsTable({
            skillRows: skillRows,
            skillHref: "/review/gdad-evidence/" + targetPersonId + "/",
            scoreControls: true,
            errorSkillKey: errorSkillKey,
            errorText: error
          }) }}

          {{ govukButton({ text: "Save scores" }) }}
        </form>

        <p class="govuk-body">
          Open a skill to read the full evidence and score it.
        </p>

        {% if scoresEmail %}
          <div id="scores-email" class="gdad-scores-email">
            <h2 class="govuk-heading-m">Tell {{ targetName }} about their scores</h2>
            {% if scoresEmail.state == "ready" %}
              {% if scoresEmail.lastSentLabel %}
                <p class="govuk-body">Last emailed on {{ scoresEmail.lastSentLabel }}.</p>
              {% endif %}
              {{ gdadScoresEmailForm({
                targetPersonId: targetPersonId,
                targetName: targetName,
                managerName: scoresEmail.managerName,
                crumb: crumb,
                secondary: true
              }) }}
            {% else %}
              <p class="govuk-body">{{ targetName }} was emailed about their scores on {{ scoresEmail.lastSentLabel }}.</p>
            {% endif %}
          </div>
        {% endif %}
      {% else %}
        {{ govukInsetText({
          text: "Scores are given by the Head of Design. You can see them here to plan next steps with " + targetName + "."
        }) }}

        {{ gdadSkillsTable({
          skillRows: skillRows,
          skillHref: "/review/gdad-evidence/" + targetPersonId + "/"
        }) }}

        <p class="govuk-body">
          Open a skill to read the full evidence.
        </p>
      {% endif %}
    </div>
  </div>
{% endblock %}
