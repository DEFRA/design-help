{% extends 'layouts/page.njk' %}
{% from "partials/gdad.njk" import gdadFrameworkLinks, gdadScoringExplainer, gdadCapabilityPanel, gdadSkillsTable %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      <a class="govuk-back-link" href="/my-team">Back to My team</a>

      {% if error and canEditScores %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [{ text: error, href: "#score-" + errorSkillKey }]
        }) }}
      {% endif %}

      <span class="govuk-caption-l">{{ targetName }} · {{ targetRole }}</span>
      <h1 class="govuk-heading-xl">GDaD evidence</h1>

      {% if justSaved and canEditScores %}
        {{ govukNotificationBanner({
          type: "success",
          text: "Scores saved."
        }) }}
      {% endif %}

      {{ gdadFrameworkLinks({
        frameworkRoleLabel: frameworkRoleLabel,
        frameworkRolePageUrl: frameworkRolePageUrl,
        gdadSkillsMatrixUrl: gdadSkillsMatrixUrl
      }) }}
      {{ gdadScoringExplainer() }}

      {{ gdadCapabilityPanel(capabilityBand) }}

      {% if canEditScores %}
        <form method="post" action="/review/gdad-evidence/{{ targetPersonId }}" novalidate>
          <input type="hidden" name="crumb" value="{{ crumb }}">
          {{ gdadSkillsTable({
            skillRows: skillRows,
            skillHref: "/review/gdad-evidence/" + targetPersonId + "/",
            scoreControls: true,
            errorSkillKey: errorSkillKey,
            errorText: error
          }) }}

          {{ govukButton({ text: "Save scores" }) }}
        </form>

        <p class="govuk-body">
          Open a skill to read the full evidence and score it.
        </p>
      {% else %}
        {{ govukInsetText({
          text: "Scores are given by the Head of Design. You can see them here to plan next steps with " + targetName + "."
        }) }}

        {{ gdadSkillsTable({
          skillRows: skillRows,
          skillHref: "/review/gdad-evidence/" + targetPersonId + "/"
        }) }}

        <p class="govuk-body">
          Open a skill to read the full evidence.
        </p>
      {% endif %}
    </div>
  </div>
{% endblock %}
