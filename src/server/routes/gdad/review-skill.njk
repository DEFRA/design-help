{% extends 'layouts/page.njk' %}
{% from "partials/gdad.njk" import gdadSkillDetail %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <a class="govuk-back-link" href="/review/gdad-evidence/{{ targetPersonId }}">Back to {{ targetName }}’s GDaD evidence</a>

      {% if justSaved %}
        {{ govukNotificationBanner({
          type: "success",
          text: "Score saved for " + skill.label + "."
        }) }}
      {% endif %}

      {% if error %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [{ text: error, href: "#score-" + skill.key }]
        }) }}
      {% endif %}

      <span class="govuk-caption-l">{{ targetName }} · GDaD evidence</span>
      <h1 class="govuk-heading-xl">{{ skill.label }}</h1>

      {{ gdadSkillDetail({
        skill: skill,
        frameworkRoleLabel: frameworkRoleLabel,
        frameworkRolePageUrl: frameworkRolePageUrl,
        gdadSkillsMatrixUrl: gdadSkillsMatrixUrl
      }) }}

      <h2 class="govuk-heading-m">Evidence (STAR)</h2>
      <div class="govuk-inset-text">
        {% if skill.evidenceText %}
          {{ skill.evidenceText | markdownToGovukHtml }}
        {% else %}
          <p class="govuk-body govuk-!-margin-bottom-0 govuk-hint">No evidence yet.</p>
        {% endif %}
      </div>

      {% if not canEditScores %}
        {{ govukInsetText({
          text: "You can review evidence, but only Head of Design can save official scores."
        }) }}
      {% endif %}

      <form method="post" action="/review/gdad-evidence/{{ targetPersonId }}/{{ skill.key }}" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">
        {{ govukSelect({
          id: "score-" + skill.key,
          name: "score_" + skill.key,
          label: {
            text: "Change score" if skill.officialScore else "Score",
            classes: "govuk-label--m"
          },
          items: [
            { value: "", text: "Not set", selected: not skill.officialScore },
            { value: "1", text: "1 — Below standard", selected: skill.officialScore == 1 },
            { value: "2", text: "2 — At standard", selected: skill.officialScore == 2 },
            { value: "3", text: "3 — Above standard", selected: skill.officialScore == 3 }
          ],
          disabled: not canEditScores,
          errorMessage: { text: error } if error
        }) }}

        {% if canEditScores %}
          {{ govukButton({ text: "Save score" }) }}
        {% endif %}
      </form>
    </div>
  </div>
{% endblock %}
