{% extends 'layouts/page.njk' %}
{% from "partials/gdad.njk" import gdadSkillDetail, gdadEvidenceSections %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <a class="govuk-back-link" href="/review/gdad-evidence/{{ targetPersonId }}">Back to {{ targetName }}’s GDaD evidence</a>

      {% if justSaved and canEditScores %}
        {{ govukNotificationBanner({
          type: "success",
          text: "Score saved for " + skill.label + "."
        }) }}
      {% endif %}

      {% if nothingChanged and canEditScores %}
        {{ govukNotificationBanner({ text: "The score for " + skill.label + " was not changed." }) }}
      {% endif %}

      {% if evidenceBanner and canEditEvidence %}
        {% if evidenceBanner.success %}
          {{ govukNotificationBanner({ type: "success", text: evidenceBanner.text }) }}
        {% else %}
          {{ govukNotificationBanner({ text: evidenceBanner.text }) }}
        {% endif %}
      {% endif %}

      {% if error and canEditScores %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [{ text: error, href: "#score-" + skill.key }]
        }) }}
      {% endif %}

      <span class="govuk-caption-l">{{ targetName }} · GDaD evidence</span>
      <h1 class="govuk-heading-xl">{{ skill.label }}</h1>

      {{ gdadSkillDetail({
        skill: skill,
        frameworkRoleLabel: frameworkRoleLabel,
        frameworkRolePageUrl: frameworkRolePageUrl
      }) }}

      {{ gdadEvidenceSections({
        skill: skill,
        skillUrl: skillUrl,
        canEdit: canEditEvidence,
        isOwn: false,
        personName: targetName
      }) }}

      {% if canEditScores %}
        <form method="post" action="/review/gdad-evidence/{{ targetPersonId }}/{{ skill.key }}" novalidate>
          <input type="hidden" name="crumb" value="{{ crumb }}">
          {% if skill.hasNewEvidence %}
            {% set scoreLabelText = "Score for the new evidence" %}
          {% elif skill.officialScore %}
            {% set scoreLabelText = "Change score" %}
          {% else %}
            {% set scoreLabelText = "Score" %}
          {% endif %}
          {{ govukSelect({
            id: "score-" + skill.key,
            name: "score_" + skill.key,
            label: {
              text: scoreLabelText,
              classes: "govuk-label--m"
            },
            hint: { text: "Saving a score moves the current evidence and its score to Previous evidence." } if skill.hasNewEvidence,
            items: [
              { value: "", text: skill.blankScoreText, selected: not skill.scoreSelectValue },
              { value: "1", text: "1 — Below standard", selected: skill.scoreSelectValue == 1 },
              { value: "2", text: "2 — At standard", selected: skill.scoreSelectValue == 2 },
              { value: "3", text: "3 — Above standard", selected: skill.scoreSelectValue == 3 }
            ],
            errorMessage: { text: error } if error
          }) }}

          {{ govukButton({ text: "Save score" }) }}
        </form>
      {% else %}
        <p class="govuk-body">Scores are given by the Head of Design.</p>
      {% endif %}
    </div>
  </div>
{% endblock %}
