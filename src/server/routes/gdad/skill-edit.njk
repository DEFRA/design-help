{% extends 'layouts/page.njk' %}
{% from "partials/gdad.njk" import gdadSkillDetail %}

{# Editing the current evidence, or writing new evidence (mode "new"), for
   the designer themselves or the Head of Design on their behalf #}
{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <a class="govuk-back-link" href="{{ skillUrl }}">Back to {{ skill.label }}</a>

      {% if error %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [{ text: error, href: "#evidence-" + skill.key }]
        }) }}
      {% endif %}

      <span class="govuk-caption-l">{{ personName }} · {{ captionText }}</span>
      <h1 class="govuk-heading-xl">{{ skill.label }}</h1>

      {{ gdadSkillDetail({
        skill: skill,
        frameworkRoleLabel: frameworkRoleLabel,
        frameworkRolePageUrl: frameworkRolePageUrl
      }) }}

      {% if isNewEvidence %}
        <h2 class="govuk-heading-m">New evidence (STAR)</h2>
        <p class="govuk-body">
          {% if isOwn %}
            Your current evidence and score stay as they are until your new evidence is scored.
          {% else %}
            The current evidence and score stay as they are until the new evidence is scored.
          {% endif %}
        </p>
      {% else %}
        <h2 class="govuk-heading-m">Evidence (STAR)</h2>
      {% endif %}

      <form method="post" action="{{ formAction }}" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {{ govukCharacterCount({
          id: "evidence-" + skill.key,
          name: "evidence_" + skill.key,
          maxlength: 12000,
          rows: 12,
          value: evidenceValue,
          label: {
            text: evidenceLabel,
            classes: "govuk-label--s"
          },
          hint: {
            text: skill.starHint
          },
          errorMessage: { text: error } if error
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({ text: "Save new evidence" if isNewEvidence else "Save evidence" }) }}
          <a class="govuk-link" href="{{ skillUrl }}">Cancel</a>
        </div>
      </form>

    </div>
  </div>
{% endblock %}
