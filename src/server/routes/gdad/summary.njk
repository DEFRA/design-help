{% extends 'layouts/page.njk' %}
{% from "partials/gdad.njk" import gdadFrameworkLinks, gdadScoringExplainer, gdadCapabilityPanel, gdadSkillsTable %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <span class="govuk-caption-l">{{ user.name }}</span>
      <h1 class="govuk-heading-xl">My GDaD evidence</h1>

      {% if csvImportUpdatedCount and csvImportUpdatedCount > 0 %}
        {{ govukNotificationBanner({
          type: "success",
          text: "Imported evidence for " + csvImportUpdatedCount + " skill(s)."
        }) }}
      {% endif %}

      {{ gdadFrameworkLinks({
        frameworkRoleLabel: frameworkRoleLabel,
        frameworkRolePageUrl: frameworkRolePageUrl,
        gdadSkillsMatrixUrl: gdadSkillsMatrixUrl
      }) }}
      {{ gdadScoringExplainer() }}

      {{ gdadCapabilityPanel(capabilityBand) }}

      {{ gdadSkillsTable({
        skillRows: skillRows,
        skillHref: "/my-gdad-evidence/"
      }) }}

      <p class="govuk-body">
        Open a skill to write or change your evidence.
      </p>

      <h2 class="govuk-heading-m">Add evidence from a spreadsheet</h2>
      <p class="govuk-body">
        <a class="govuk-link" href="/my-gdad-evidence/import-csv">Import evidence from CSV template</a>.
        Download blank templates by grade:
        <a class="govuk-link" href="/gdad-reference/template-seo.csv">SEO</a>,
        <a class="govuk-link" href="/gdad-reference/template-g7.csv">G7</a>,
        <a class="govuk-link" href="/gdad-reference/template-g6.csv">G6</a>.
      </p>

      {% if headOfDesignSelfReview %}
        <p class="govuk-body govuk-!-margin-bottom-6">
          <a class="govuk-link" href="/review/gdad-evidence/{{ selfPersonId }}">Review my official scores (Head of Design special case)</a>
          with your manager during your in-person review.
        </p>
      {% endif %}
    </div>
  </div>
{% endblock %}
