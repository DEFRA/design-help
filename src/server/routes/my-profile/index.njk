{% extends 'layouts/page.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">My profile</h1>

      {% if profile %}
        {% if not profile.location or not profile.experience %}
          {{ govukInsetText({
            html: 'Your profile has been started for you. <a class="govuk-link" href="/my-profile/edit">Finish your profile</a> by adding your location, experience and availability.'
          }) }}
        {% endif %}

        <div class="govuk-button-group">
          <a href="/my-profile/edit" class="govuk-button" data-module="govuk-button">Edit my profile</a>
          <a href="/my-profile/helping" class="govuk-button govuk-button--secondary" data-module="govuk-button">I&rsquo;m helping someone</a>
          {% if gdadEvidenceApplicable %}
            <a href="/my-gdad-evidence" class="govuk-button govuk-button--secondary" data-module="govuk-button">Submit your GDaD evidence</a>
          {% endif %}
        </div>

        {% if gdadEvidenceApplicable %}
          <h2 class="govuk-heading-m govuk-!-margin-top-6">GDaD design skills evidence</h2>
          <p class="govuk-body">
            Add or update STAR-style evidence for each of the seven DDaT design skills. You can save each skill and return later. <a class="govuk-link" href="/my-gdad-evidence">Go to your GDaD evidence overview</a>.
          </p>
        {% endif %}

        <dl class="govuk-summary-list">
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Name</dt>
            <dd class="govuk-summary-list__value">{{ profile.name }}</dd>
          </div>
          {% if profile.email or profile.contactEmail %}
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Email</dt>
              <dd class="govuk-summary-list__value">
                <a class="govuk-link" href="mailto:{{ profile.email or profile.contactEmail }}">{{ profile.email or profile.contactEmail }}</a>
              </dd>
            </div>
          {% endif %}
          {% if profile.contactEmail and profile.email and profile.contactEmail != profile.email %}
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Contact email</dt>
              <dd class="govuk-summary-list__value">
                <a class="govuk-link" href="mailto:{{ profile.contactEmail }}">{{ profile.contactEmail }}</a>
              </dd>
            </div>
          {% endif %}
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Job title</dt>
            <dd class="govuk-summary-list__value">{{ profile.role }}</dd>
          </div>
          {% if profile.projectTeam %}
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Project team</dt>
              <dd class="govuk-summary-list__value">{{ profile.projectTeam }}</dd>
            </div>
          {% endif %}
          {% if profile.deliveryGroup %}
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Delivery group</dt>
              <dd class="govuk-summary-list__value">{{ profile.deliveryGroup }}</dd>
            </div>
          {% endif %}
          {% if profile.location %}
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Location</dt>
              <dd class="govuk-summary-list__value">{{ profile.location }}</dd>
            </div>
          {% endif %}
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Availability</dt>
            <dd class="govuk-summary-list__value">{{ profile.availabilityStatus }}</dd>
          </div>
          {% if profile.experience %}
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Experience</dt>
              <dd class="govuk-summary-list__value">{{ profile.experience }}</dd>
            </div>
          {% endif %}
          {% if helpingPeople.length %}
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Long-term help (who I&rsquo;m helping)</dt>
              <dd class="govuk-summary-list__value">
                <ul class="govuk-list">
                  {% for h in helpingPeople %}
                    <li><a class="govuk-link" href="{{ h.path }}">{{ h.name }}</a></li>
                  {% endfor %}
                </ul>
              </dd>
            </div>
          {% endif %}
        </dl>

        {% set member = profile %}
        {% include "partials/profile-free-text.njk" %}

        {% if publicProfilePath %}
          <p class="govuk-body govuk-!-margin-top-6">
            <a class="govuk-link" href="{{ publicProfilePath }}">See your profile as others see it</a>
          </p>
        {% endif %}
      {% else %}
        <p class="govuk-body">You do not have a profile yet.</p>
        <p class="govuk-body">
          <a href="/my-profile/edit" class="govuk-button" data-module="govuk-button">Create my profile</a>
        </p>
      {% endif %}
    </div>
  </div>
{% endblock %}
