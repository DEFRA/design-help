{#
  Shared pieces of the GDaD pages. The designer's own view (/my-gdad-evidence)
  and the manager's view of them (/review/gdad-evidence/...) are built from
  these so both show the same skills, in the same order, with the same words
  — a manager and designer on a call can say "the third skill down" and mean
  the same thing. The Head of Design's view adds scoring controls (line
  managers see the same as the designer, without editing); the designer's
  view adds evidence editing.
#}

{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}

{% macro gdadScoreText(skill) %}
  {%- if skill.officialScore -%}
    {{ skill.officialScore }} — {{ skill.scoreLabel }}
  {%- else -%}
    Not scored yet
  {%- endif -%}
{% endmacro %}

{# "Scored 2 — At standard on 10 November 2026" #}
{% macro gdadScoredLine(score, scoreLabel, dateLabel) -%}
  Scored {{ score }} — {{ scoreLabel }}{% if dateLabel %} on {{ dateLabel }}{% endif %}
{%- endmacro %}

{# One line linking to the designer's level on the framework role page. #}
{% macro gdadFrameworkLinks(params) %}
  <p class="govuk-body">
    Expected levels: <a class="govuk-link" href="{{ params.frameworkRolePageUrl }}" target="_blank" rel="noopener noreferrer">{{ params.frameworkRoleLabel }} on the DDaT capability framework (opens in a new tab)</a>
  </p>
{% endmacro %}

{#
  The designer's overall score: the total of their best 6 of 7 skill scores
  and the rating that total gives.
#}
{% macro gdadCapabilityPanel(capabilityBand) %}
  <div class="govuk-inset-text govuk-!-margin-bottom-6">
    {% if capabilityBand.ready and capabilityBand.band %}
      <h2 class="govuk-heading-m govuk-!-margin-bottom-2">Score {{ capabilityBand.total }} — {{ capabilityBand.band.rating }}</h2>
    {% else %}
      <h2 class="govuk-heading-m govuk-!-margin-bottom-2">No score yet</h2>
      <p class="govuk-body govuk-!-margin-bottom-2">{{ capabilityBand.scoredSkillsCount }} of 6 skills scored so far.</p>
    {% endif %}
    <p class="govuk-body-s govuk-!-margin-bottom-0">
      Total of the best 6 of 7 skill scores. The Head of Design scores each skill 1 (below expected level), 2 (at expected level) or 3 (above expected level).
    </p>
  </div>
{% endmacro %}

{#
  params.skillRows    — from buildSkillRows (always the 7 skills in framework order)
  params.skillHref    — link prefix for each skill page; the skill key is appended
  params.scoreControls — true on the Head of Design's view: adds a "Change score" column
  params.errorSkillKey / params.errorText — show an error next to that skill's score
#}
{% macro gdadSkillsTable(params) %}
  <div tabindex="0" role="region" aria-label="Skills table, scrolls sideways" class="gdad-table-scroll govuk-!-margin-bottom-6">
    <table class="govuk-table">
      <caption class="govuk-table__caption govuk-table__caption--m">Skills</caption>
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">Skill</th>
          <th scope="col" class="govuk-table__header">Evidence</th>
          <th scope="col" class="govuk-table__header">Expected level</th>
          <th scope="col" class="govuk-table__header">Score</th>
          <th scope="col" class="govuk-table__header">Graded level</th>
          {% if params.scoreControls %}
            <th scope="col" class="govuk-table__header">Change score</th>
          {% endif %}
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for skill in params.skillRows %}
          <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">
              <a class="govuk-link govuk-link--no-visited-state" href="{{ params.skillHref }}{{ skill.key }}">{{ skill.label }}</a>
            </th>
            <td class="govuk-table__cell">
              {% if skill.evidenceText %}
                Added
                {% if skill.evidenceUpdatedLabel %}
                  <span class="govuk-hint govuk-body-s govuk-!-display-block govuk-!-margin-bottom-0">Last updated {{ skill.evidenceUpdatedLabel }}</span>
                {% endif %}
                {% if skill.hasNewEvidence %}
                  <strong class="govuk-tag govuk-tag--blue govuk-!-display-block govuk-!-margin-top-1 gdad-tag-fit">New evidence</strong>
                {% endif %}
              {% else %}
                None yet
              {% endif %}
            </td>
            <td class="govuk-table__cell">
              <strong class="govuk-tag {{ skill.expectedBand.tagClass }}">{{ skill.expectedBand.label }}</strong>
            </td>
            <td class="govuk-table__cell">
              {{ gdadScoreText(skill) }}
              {% if skill.hasNewEvidence and skill.officialScore %}
                <span class="govuk-hint govuk-body-s govuk-!-display-block govuk-!-margin-bottom-0">Based on previous evidence</span>
              {% elif skill.needsScoring and skill.officialScore %}
                <strong class="govuk-tag govuk-tag--yellow govuk-!-display-block govuk-!-margin-top-1 gdad-tag-fit">Evidence changed since scored</strong>
              {% endif %}
            </td>
            <td class="govuk-table__cell">
              {% if skill.gradedLevel %}
                <strong class="govuk-tag {{ skill.gradedLevel.tagClass }}">{{ skill.gradedLevel.label }}</strong>
              {% else %}
                <span class="govuk-hint">&mdash;</span>
              {% endif %}
            </td>
            {% if params.scoreControls %}
              <td class="govuk-table__cell">
                {{ govukSelect({
                  id: "score-" + skill.key,
                  name: "score_" + skill.key,
                  label: {
                    text: ("Score for the new evidence for " if skill.hasNewEvidence else "Score for ") + skill.label,
                    classes: "govuk-visually-hidden"
                  },
                  items: [
                    { value: "", text: skill.blankScoreText, selected: not skill.scoreSelectValue },
                    { value: "1", text: "1 — Below standard", selected: skill.scoreSelectValue == 1 },
                    { value: "2", text: "2 — At standard", selected: skill.scoreSelectValue == 2 },
                    { value: "3", text: "3 — Above standard", selected: skill.scoreSelectValue == 3 }
                  ],
                  formGroup: { classes: "govuk-!-margin-bottom-0" },
                  errorMessage: { text: params.errorText } if params.errorText and params.errorSkillKey == skill.key
                }) }}
              </td>
            {% endif %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endmacro %}

{# Top of each per-skill page: framework links, expected standard and where the skill stands. #}
{% macro gdadSkillDetail(params) %}
  {% set skill = params.skill %}
  <p class="govuk-body">
    <a class="govuk-link" href="{{ skill.frameworkUrl }}" target="_blank" rel="noopener noreferrer">Full skill description on the DDaT framework (opens in a new tab)</a>
    · <a class="govuk-link" href="{{ params.frameworkRolePageUrl }}" target="_blank" rel="noopener noreferrer">Designer role — {{ params.frameworkRoleLabel }} (opens in a new tab)</a>
  </p>

  <div class="govuk-inset-text">
    <p class="govuk-body govuk-!-margin-bottom-2">
      <strong>Expected level for this skill ({{ params.frameworkRoleLabel }}):</strong>
      <strong class="govuk-tag {{ skill.expectedBand.tagClass }}">{{ skill.expectedBand.label }}</strong>
    </p>
    <p class="govuk-body-s govuk-!-margin-bottom-0">{{ skill.expectedBand.description }}</p>
  </div>

  <dl class="govuk-summary-list govuk-!-margin-bottom-6">
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Evidence</dt>
      <dd class="govuk-summary-list__value">
        {% if skill.evidenceText %}
          Added{% if skill.evidenceUpdatedLabel %} — last updated {{ skill.evidenceUpdatedLabel }}{% endif %}
          {% if skill.hasNewEvidence %}
            <strong class="govuk-tag govuk-tag--blue govuk-!-margin-left-1">New evidence</strong>
          {% endif %}
        {% else %}
          None yet
        {% endif %}
      </dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Score</dt>
      <dd class="govuk-summary-list__value">
        {{ gdadScoreText(skill) }}
        {% if skill.needsScoring and skill.officialScore and not skill.hasNewEvidence %}
          <strong class="govuk-tag govuk-tag--yellow govuk-!-margin-left-1">Evidence changed since scored</strong>
        {% endif %}
      </dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Graded level</dt>
      <dd class="govuk-summary-list__value">
        {% if skill.gradedLevel %}
          <strong class="govuk-tag {{ skill.gradedLevel.tagClass }}">{{ skill.gradedLevel.label }}</strong>
          <span class="govuk-visually-hidden">. {{ skill.gradedLevel.summary }}</span>
        {% else %}
          &mdash;
        {% endif %}
      </dd>
    </div>
  </dl>
{% endmacro %}

{#
  The Head of Design's "Email <name>" form: the same words on the page
  shown straight after saving scores (primary button) and at the bottom of
  the person's evidence page (secondary button).
#}
{% macro gdadScoresEmailForm(params) %}
  <p class="govuk-body">You can email {{ params.targetName }} to tell them their scores have been updated. The email links to their GDaD evidence in Design Help. It does not include their scores.</p>
  {% if params.managerName %}
    <p class="govuk-body" id="scores-email-copy">Their line manager, {{ params.managerName }}, will be copied in.</p>
  {% endif %}
  <form method="post" action="/review/gdad-evidence/{{ params.targetPersonId }}/notify-scores" novalidate>
    <input type="hidden" name="crumb" value="{{ params.crumb }}">
    {{ govukButton({
      text: "Email " + params.targetName,
      classes: "govuk-button--secondary" if params.secondary else "",
      preventDoubleClick: true,
      attributes: { "aria-describedby": "scores-email-copy" } if params.managerName else {}
    }) }}
  </form>
{% endmacro %}

{#
  A skill's evidence on its reading page: the current evidence, any new
  evidence (towards the next review, not yet scored) and previous evidence
  (replaced when new evidence was scored). The same on the designer's page
  and the reviewer's page.
  params.skill      — a row from buildSkillRows
  params.skillUrl   — the skill's reading page; /edit, /new and /discard-new hang off it
  params.canEdit    — show the buttons to change the evidence
  params.isOwn      — the designer's own page ("your"); otherwise the reviewer's
  params.personName — whose evidence it is, for the reviewer's wording
#}
{% macro gdadEvidenceSections(params) %}
  {% set skill = params.skill %}
  {% set base = params.skillUrl %}

  {% if skill.hasNewEvidence %}
    <h2 class="govuk-heading-m">New evidence <strong class="govuk-tag govuk-tag--blue gdad-heading-tag">New evidence</strong></h2>
    {{ skill.newEvidenceText | markdownToGovukHtml }}
    {% if skill.newEvidenceUpdatedLabel %}
      <p class="govuk-body-s govuk-hint">Last updated {{ skill.newEvidenceUpdatedLabel }}</p>
    {% endif %}
    {% if params.canEdit %}
      <div class="govuk-button-group">
        {{ govukButton({
          text: "Edit new evidence",
          href: base + "/new",
          classes: "govuk-button--secondary"
        }) }}
        <a class="govuk-link" href="{{ base }}/discard-new">Discard new evidence</a>
      </div>
    {% endif %}

    <h2 class="govuk-heading-m">Current evidence</h2>
    <div class="govuk-inset-text">
      {% if skill.officialScore %}
        {{ "Your" if params.isOwn else "The" }} current score of {{ skill.officialScore }}{% if skill.scoredDateLabel %} ({{ skill.scoredDateLabel }}){% endif %} is based on this evidence, not {{ "your" if params.isOwn else "the" }} new evidence.
      {% else %}
        {{ "Your" if params.isOwn else "The" }} current evidence has not been scored.
      {% endif %}
    </div>
    {{ skill.evidenceText | markdownToGovukHtml }}
    {% if skill.evidenceUpdatedLabel %}
      <p class="govuk-body-s govuk-hint">Last updated {{ skill.evidenceUpdatedLabel }}</p>
    {% endif %}
  {% else %}
    <h2 class="govuk-heading-m">Evidence (STAR)</h2>
    {% if skill.evidenceText %}
      {{ skill.evidenceText | markdownToGovukHtml }}
      {% if skill.evidenceUpdatedLabel %}
        <p class="govuk-body-s govuk-hint">Last updated {{ skill.evidenceUpdatedLabel }}</p>
      {% endif %}
      {% if skill.officialScore %}
        <p class="govuk-body">{{ gdadScoredLine(skill.officialScore, skill.scoreLabel, skill.scoredDateLabel) }}</p>
      {% endif %}
      {% if params.canEdit %}
        {% if skill.canStartNewEvidence %}
          <p class="govuk-hint">
            {% if params.isOwn %}
              Start new evidence when you’re working towards your next review. Your current score stays until the new evidence is scored.
            {% else %}
              Start new evidence when {{ params.personName }} is working towards their next review. Their current score stays until the new evidence is scored.
            {% endif %}
          </p>
          <div class="govuk-button-group">
            {{ govukButton({
              text: "Start new evidence",
              href: base + "/new"
            }) }}
            {{ govukButton({
              text: "Edit existing evidence",
              href: base + "/edit",
              classes: "govuk-button--secondary"
            }) }}
          </div>
        {% else %}
          {{ govukButton({
            text: "Edit evidence",
            href: base + "/edit",
            classes: "govuk-button--secondary"
          }) }}
        {% endif %}
      {% endif %}
    {% else %}
      {% if params.isOwn %}
        <p class="govuk-body">You haven’t added evidence for this skill yet.</p>
      {% else %}
        <p class="govuk-body govuk-hint">No evidence yet.</p>
      {% endif %}
      {% if params.canEdit %}
        {{ govukButton({
          text: "Add evidence",
          href: base + "/edit"
        }) }}
      {% endif %}
    {% endif %}
  {% endif %}

  {% if skill.previous.length %}
    <h2 class="govuk-heading-m">Previous evidence</h2>
    {% for entry in skill.previous %}
      {% set entryHtml %}
        {{ entry.evidenceText | markdownToGovukHtml }}
        {% if entry.archivedDateLabel %}
          <p class="govuk-body-s govuk-hint govuk-!-margin-bottom-0">Moved to previous evidence on {{ entry.archivedDateLabel }}</p>
        {% endif %}
      {% endset %}
      {{ govukDetails({
        summaryText: gdadScoredLine(entry.officialScore, entry.scoreLabel, entry.scoredDateLabel) if entry.officialScore else "Not scored",
        html: entryHtml
      }) }}
    {% endfor %}
  {% endif %}
{% endmacro %}
