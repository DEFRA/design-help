# Frontend-only local development against the DEPLOYED dev backend
# (live data). Copy to .env and fill in the two blank values.
#
# Needs: being on the Defra network (office or VPN), and the design-help-backend PRIVATE API gateway
# (request once from #cdp-support). See "Frontend-only local development"
# in the README for where the client id/secret come from.
#
# .env is gitignored — never commit the filled-in copy.

PORT=3000

# The backend through its API gateway (resolves on the Defra network)
BACKEND_API_URL=https://design-help-backend.api.dev.cdp-int.defra.cloud

# Cognito client-credentials for the gateway
BACKEND_API_TOKEN_URL=https://design-help-backend-SUFFIX.auth.eu-west-2.amazoncognito.com/oauth2/token
BACKEND_API_CLIENT_ID=
BACKEND_API_CLIENT_SECRET=

# Your own email: makes you an admin locally and allows the
# Head of Design job title
ADMIN_EMAILS=you@defra.gov.uk
GDAD_HEAD_OF_DESIGN_EMAILS=you@defra.gov.uk
